{
  "name": "rah",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "rah": "./bin/rah.mjs"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:conversation": "node --import tsx --test --test-force-exit packages/runtime-daemon/src/provider-capability-bindings.test.ts packages/runtime-daemon/src/conversation-resource-projector.test.ts packages/runtime-daemon/src/conversation-projector.test.ts packages/runtime-daemon/src/conversation-projection-store.test.ts packages/runtime-daemon/src/codex-app-server-activity.test.ts packages/runtime-daemon/src/codex-app-server-resume.test.ts",
    "rah": "node ./bin/rah.mjs",
    "build:web": "npm --prefix packages/client-web run build",
    "dev:web": "npm --prefix packages/client-web run dev",
    "dev:daemon": "npm --prefix packages/runtime-daemon run dev",
    "serve:workbench": "npm run build:web && npm run dev:daemon",
    "typecheck": "tsc -p packages/runtime-protocol/tsconfig.json --noEmit && tsc -p packages/runtime-daemon/tsconfig.json --noEmit && tsc -p packages/client-web/tsconfig.json --noEmit",
    "test:session-commands": "node --import tsx --test --test-force-exit packages/client-web/src/session-store-session-commands.test.ts",
    "test:council-web": "node --import tsx --test --test-force-exit packages/client-web/src/council/council-message-window.test.ts",
    "test:ci": "npm run typecheck && npm run test:protocol && npm run test:web && npm run test:web-build && npm run test:runtime && npm run build:web && npm audit --omit=dev",
    "test:web-build": "node --test scripts/web-build-retention.test.mjs",
    "test:stored-catalog": "node --import tsx --test --test-force-exit packages/runtime-daemon/src/stored-session-catalog.test.ts",
    "test:web": "node scripts/run-package-tests.mjs packages/client-web/src",
    "test:runtime": "node scripts/run-package-tests.mjs --concurrency=1 packages/runtime-daemon/src",
    "test:auth": "node --import tsx --test --test-force-exit packages/runtime-daemon/src/device-auth.test.ts",
    "test:protocol": "node scripts/run-package-tests.mjs packages/runtime-protocol/src",
    "test:native-tui": "bash scripts/native-tui-gate.sh",
    "test:tui-mux-auto": "bash scripts/tui-mux-auto-gate.sh",
    "test:tui-mux": "bash scripts/tui-mux-gate.sh",
    "test:provider-contracts": "node --import tsx --test --test-force-exit packages/runtime-protocol/src/contract.test.ts packages/runtime-protocol/src/live-backend-policy.test.ts packages/runtime-daemon/src/provider-activity.test.ts packages/runtime-daemon/src/native-tui-provider-runtime.test.ts packages/runtime-daemon/src/native-tui-catalog-adapters.test.ts packages/runtime-daemon/src/native-tui-launch-spec.test.ts packages/runtime-daemon/src/runtime-terminal-capabilities.test.ts packages/runtime-daemon/src/native-local-server-attach.test.ts packages/runtime-daemon/src/session-model-options.test.ts packages/runtime-daemon/src/runtime-engine.test.ts packages/runtime-daemon/src/codex-rollout-activity.test.ts packages/runtime-daemon/src/claude-session-files.test.ts packages/runtime-daemon/src/opencode-activity.test.ts packages/runtime-daemon/src/opencode-stored-sessions.test.ts packages/client-web/src/session-store-session-startup.test.ts packages/client-web/src/composer-contract.test.ts packages/client-web/src/provider-capabilities.test.ts packages/client-web/src/components/chat/markdown-blocks.test.ts",
    "test:regression:e2e-plan": "tsx scripts/regression_e2e_manifest.ts --check",
    "test:regression:e2e-list": "tsx scripts/regression_e2e_manifest.ts --markdown",
    "test:regression:e2e-browser": "tsx scripts/regression_e2e_browser_gate.ts",
    "test:smoke:history-resume": "bash scripts/history-resume-smoke.sh",
    "test:smoke:stored-catalog-browser": "bash scripts/stored-session-catalog-browser-smoke.sh",
    "test:smoke:inspector-browser": "bash scripts/inspector-browser-smoke.sh",
    "test:smoke:terminal": "tsx scripts/terminal_smoke.ts",
    "test:smoke:native-codex": "tsx scripts/native_codex_smoke.ts",
    "test:smoke:native-codex-browser": "bash scripts/native-codex-browser-smoke.sh",
    "test:smoke:native-providers": "tsx scripts/native_provider_smoke.ts",
    "test:smoke:native-provider-browser": "bash scripts/native-provider-browser-smoke.sh",
    "test:smoke:native-browser": "npm run test:smoke:native-codex-browser && npm run test:smoke:native-provider-browser",
    "test:smoke:native-browser-webkit": "RAH_NATIVE_BROWSER=webkit npm run test:smoke:native-codex-browser && RAH_NATIVE_BROWSER=webkit npm run test:smoke:native-provider-browser",
    "test:smoke:native-browser-firefox": "RAH_NATIVE_BROWSER=firefox npm run test:smoke:native-codex-browser && RAH_NATIVE_BROWSER=firefox npm run test:smoke:native-provider-browser",
    "test:smoke:tui-surface-lifecycle-browser": "python3 scripts/tui_surface_lifecycle_browser_smoke.py",
    "test:smoke:native-cli-probe": "tsx scripts/native_cli_probe.ts",
    "test:smoke:native-local-server": "tsx scripts/native_local_server_probe.ts",
    "test:smoke:conversation-providers": "tsx scripts/conversation_provider_conformance.ts",
    "test:smoke:session-control-capabilities": "tsx scripts/session_control_capability_probe.ts",
    "test:smoke:session-control-token-order": "RAH_SESSION_CONTROL_REQUIRE_TOKEN_ORDER=1 tsx scripts/session_control_capability_probe.ts",
    "test:smoke:native-real-tui-launch": "tsx scripts/native_real_tui_launch_probe.ts",
    "test:smoke:native-qa-status": "tsx scripts/native_qa_status.ts",
    "test:smoke:native-manual-qa-status": "tsx scripts/native_manual_qa_status.ts",
    "test:manual-qa-status": "node --import tsx --test --test-force-exit scripts/native_manual_qa_status.test.ts",
    "test:smoke:terminal-browser": "bash scripts/terminal-browser-smoke.sh",
    "test:smoke:tool-flow": "bash scripts/tool-flow-smoke.sh",
    "test:smoke:claude-flow": "bash scripts/claude-flow-smoke.sh",
    "test:smoke:claude-browser": "bash scripts/claude-browser-smoke.sh",
    "test:smoke:codex-browser": "bash scripts/codex-browser-smoke.sh",
    "test:smoke:opencode-browser": "bash scripts/opencode-browser-smoke.sh",
    "test:smoke:browser-providers": "npm run test:smoke:native-browser",
    "test:smoke:real-browser-providers": "npm run test:smoke:codex-browser && npm run test:smoke:claude-browser && npm run test:smoke:opencode-browser",
    "test:smoke:provider-flows": "npm run test:smoke:codex-browser && npm run test:smoke:claude-flow && npm run test:smoke:opencode-browser",
    "test:history-directory": "node --import tsx --test --test-force-exit packages/runtime-daemon/src/codex-turn-directory.test.ts packages/runtime-daemon/src/conversation-turn-directory.test.ts packages/runtime-daemon/src/http-server-response.test.ts packages/client-web/src/session-store-conversation-directory.test.ts packages/client-web/src/components/chat/conversation-turn-navigation.test.ts",
    "test:smoke-cleanup": "python3 -m unittest scripts/rah_smoke_cleanup_test.py",
    "cleanup:smoke-state": "python3 scripts/cleanup_temp_rah_state.py"
  },
  "dependencies": {
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "fast-uri": "3.1.4"
  }
}
